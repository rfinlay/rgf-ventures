// ============================================================================
// RGF Ventures <> Dr. Luis Ramos -- PACS Infrastructure Assessment
// Tailnet policy file (HuJSON). Drafted 2026-09-15 for the 2026-09-16 visit.
// Tailnet owner: rfinlay813@outlook.com   (tailnet taila9a1b3.ts.net)
//
// REVISED 2026-09-15 after reading Rick's ACTUAL live policy. The first draft
// would have silently broken two things he uses today:
//   - Tailscale SSH (his live policy has an ssh block; laptop-2tjvbjfj shows
//     an SSH badge in the admin console). The first draft had "ssh": [].
//   - Funnel (his live policy grants attr funnel to autogroup:member;
//     laptop-2tjvbjfj shows a Funnel badge). The first draft had nodeAttrs: [].
// Both are PRESERVED below. Neither can ever apply to tag:pacs, because
// autogroup:member and autogroup:self match user-owned devices only and never
// match a tagged device.
//
// PURPOSE
//   Luis's Windows radiology workstation joins Rick's tailnet as tag:pacs.
//   That workstation must NEVER be able to reach back into Rick's Mac mini
//   (finance data, client work, the whole OpenClaw workspace) or any other
//   Rick device. Access is strictly one-directional: Rick -> PACS box, on a
//   small set of ports. Nothing flows PACS box -> Rick.
//
// ############################################################################
// # READ THIS BEFORE YOU PASTE                                               #
// #                                                                          #
// # Saving the policy page REPLACES THE ENTIRE POLICY FILE. Not a merge.     #
// # Rick's pre-change policy (captured 2026-09-15) was:                      #
// #   grants: [{src ["*"], dst ["*"], ip ["*"]}]                             #
// #   ssh:    [{accept, src autogroup:member, dst autogroup:self,            #
// #             users autogroup:nonroot}]                                    #
// #   nodeAttrs: [{target autogroup:member, attr ["funnel"]}]                #
// # Keep that in a scratch file as the rollback.                             #
// #                                                                          #
// # Recovery: Admin console > Configuration logs reverts to a prior version. #
// ############################################################################
//
// WHY RICK'S 4 EXISTING NODES DO NOT BREAK
//   gios-mac-mini, laptop-2tjvbjfj, iphone-15-pro-max, iphone182 are all
//   user-owned by rfinlay813@outlook.com and untagged. Rule 1 below
//   (autogroup:member -> autogroup:self:*) preserves full any-to-any access
//   among a user's own devices. Do NOT tag Rick's own machines: applying a
//   tag REMOVES user ownership, which drops the device out of autogroup:self
//   and would break rule 1 for it.
//
// SYNTAX VERIFIED AGAINST (fetched 2026-09-15):
//   https://tailscale.com/kb/1337/policy-syntax
//   https://tailscale.com/kb/1018/acls
//   https://tailscale.com/docs/reference/examples/acls
//   https://tailscale.com/docs/features/tags
//   https://tailscale.com/kb/1193/tailscale-ssh
//   https://tailscale.com/kb/1085/auth-keys
// ============================================================================

{
	// ------------------------------------------------------------------------
	// tagOwners -- who may create/apply each tag. Only Rick. Luis is not a
	// user in this tailnet and never needs to be.
	// ------------------------------------------------------------------------
	"tagOwners": {
		// The clinical workstation at Luis's house (hostname: luis-pacs).
		// Untrusted by design.
		"tag:pacs": ["rfinlay813@outlook.com"],

		// Reserved for a future RGF-owned device Rick chooses to tag
		// (e.g. a dedicated assessment laptop). Currently unused.
		"tag:rgf": ["rfinlay813@outlook.com"],
	},

	// ------------------------------------------------------------------------
	// acls -- deny by default. Only what is listed here is permitted.
	// A rule lets src START a connection to dst. Return traffic on an
	// established connection is automatically allowed, so Rick can connect in
	// and read the response without any reverse rule.
	//
	// NOTE: this replaces the previous wide-open `grants: [{src *, dst *}]`.
	// Both `acls` and `grants` are valid top-level keys; `acls` is used here
	// because port-scoped dst ("tag:pacs:22,3389") is the clearest expression
	// of least privilege. Do not mix the two forms for the same traffic.
	// ------------------------------------------------------------------------
	"acls": [
		// --- Rule 1: Rick's own devices keep talking to each other. --------
		// autogroup:self = devices owned by the SAME user as the source.
		// Keeps gios-mac-mini <-> laptop <-> iPhones working exactly as they
		// do today. autogroup:self covers user-owned devices ONLY and never
		// matches a tagged device, so tag:pacs can never be reached through
		// this rule or act through it.
		{
			"action": "accept",
			"src": ["autogroup:member"],
			"dst": ["autogroup:self:*"],
		},

		// --- Rule 2: Rick -> PACS workstation, least privilege. ------------
		//   3389/tcp = RDP. The realistic path on Windows. Requires Windows
		//              Pro AND Remote Desktop deliberately enabled.
		//   22/tcp   = SSH via Microsoft's OpenSSH Server optional feature.
		//              Tailscale SSH cannot serve a Windows target, so port 22
		//              here means OpenSSH, not Tailscale SSH.
		// Deliberately NOT "tag:pacs:*". No SMB (445), no WinRM (5985/5986).
		// If a port is genuinely needed on site, add it explicitly and re-save.
		{
			"action": "accept",
			"src": ["rfinlay813@outlook.com"],
			"dst": ["tag:pacs:22,3389"],
		},

		// --- Rule 3 (reserved, currently inert): tag:rgf -> PACS. ----------
		{
			"action": "accept",
			"src": ["tag:rgf"],
			"dst": ["tag:pacs:22,3389"],
		},

		// --- THE CORE CONTROL: there is no rule with src ["tag:pacs"]. -----
		// Tailscale ACLs are deny-by-default. Because tag:pacs never appears
		// as a SOURCE anywhere, the clinical workstation cannot initiate a
		// connection to ANY node on this tailnet -- not the Mac mini, not the
		// laptop, not the phones, not the internet via an exit node. It can
		// only answer connections Rick starts on 22/3389.
		//
		// Do not "fix" a connectivity problem by adding a tag:pacs src rule.
		// The tests block below will reject the save if you do.
	],

	// ------------------------------------------------------------------------
	// ssh -- Tailscale SSH rules. PRESERVED FROM RICK'S LIVE POLICY.
	//
	// This is Rick's existing rule, unchanged: his own devices may Tailscale
	// SSH into his own other devices as a non-root user. laptop-2tjvbjfj
	// carries an SSH badge in the admin console, so this is in active use.
	//
	// This CANNOT apply to Luis's workstation for two independent reasons:
	//   1. src is autogroup:member, which matches user-owned devices only and
	//      never matches a tagged device. tag:pacs is not a member.
	//   2. dst is autogroup:self, which likewise never matches a tagged device.
	// Additionally, Tailscale SSH cannot serve a Windows target at all
	// (https://tailscale.com/kb/1193/tailscale-ssh), so shell access to
	// Luis's box is Microsoft OpenSSH Server on TCP 22, permitted by rule 2
	// above -- ordinary SSH over the tailnet, not Tailscale SSH.
	// ------------------------------------------------------------------------
	"ssh": [
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot"],
		},
	],

	// ------------------------------------------------------------------------
	// autoApprovers -- who may advertise subnet routes / exit nodes WITHOUT a
	// human clicking approve in the admin console.
	//
	// INTENTIONALLY EMPTY. A clinical workstation must never be an exit node
	// (it would carry other devices' internet traffic) and must never
	// advertise subnet routes (it would expose Southwest X-Ray's LAN, and the
	// PACS at exa.swxrayonline.com, to this tailnet).
	//
	// laptop-2tjvbjfj currently advertises subnets. Those approvals already
	// exist per-route on the machine itself and are NOT revoked by an empty
	// autoApprovers -- this key only governs AUTO-approval of future route
	// advertisements. If a previously approved route stops working after this
	// save, re-approve it at Machines > laptop-2tjvbjfj > Route settings.
	//
	// Belt and braces: even if someone ran `tailscale up --advertise-exit-node`
	// on Luis's box, nothing auto-approves it, and nothing could route through
	// it anyway because tag:pacs has no src rule at all.
	// ------------------------------------------------------------------------
	"autoApprovers": {
		"routes": {},
		"exitNode": [],
	},

	// ------------------------------------------------------------------------
	// nodeAttrs -- PRESERVED FROM RICK'S LIVE POLICY.
	//
	// nodeAttrs GRANTS capabilities; it never revokes them. Funnel is OFF
	// unless a nodeAttrs entry turns it on. Rick's live policy grants funnel
	// to autogroup:member and laptop-2tjvbjfj carries a Funnel badge, so this
	// is in active use and is kept verbatim.
	//
	// Luis's workstation can never receive this attribute: autogroup:member
	// matches user-owned devices only and never matches a tagged device, so
	// tag:pacs is excluded by construction. There is no need to (and no way
	// to) "deny funnel" for tag:pacs -- simply never granting it is the
	// control.
	// (Verified: https://tailscale.com/kb/1337/policy-syntax)
	// ------------------------------------------------------------------------
	"nodeAttrs": [
		{
			"target": ["autogroup:member"],
			"attr":   ["funnel"],
		},
	],

	// ------------------------------------------------------------------------
	// tests -- assertions the console runs EVERY TIME the policy is saved.
	// A failed assertion makes Tailscale REJECT the save. A clean save is
	// therefore proof that the block holds.
	// (https://tailscale.com/kb/1337/policy-syntax -- "If an assertion fails,
	// Tailscale rejects the updated tailnet policy file with an error.")
	//
	// THE LOAD-BEARING INVARIANT is the first test: source tag:pacs must be
	// DENIED to tag:rgf on every port we care about.
	// ------------------------------------------------------------------------
	"tests": [
		// === INVARIANT: the PACS workstation cannot reach RGF devices. =====
		{
			"src": "tag:pacs",
			"proto": "tcp",
			"deny": [
				"tag:rgf:22",   // no SSH back into RGF gear
				"tag:rgf:3389", // no RDP back into RGF gear
				"tag:rgf:445",  // no SMB file share access
				"tag:rgf:5432", // no database access
				"tag:rgf:80",   // no HTTP to anything RGF runs
				"tag:rgf:443",  // no HTTPS to anything RGF runs
			],
		},

		// === INVARIANT: the PACS workstation cannot reach its own kind. ====
		// Lateral movement block, if a second clinical box is ever added.
		{
			"src": "tag:pacs",
			"proto": "tcp",
			"deny": ["tag:pacs:22", "tag:pacs:3389", "tag:pacs:445"],
		},

		// === Rick CAN reach the PACS box, but ONLY on 22 and 3389. ========
		// The deny list asserts the least-privilege boundary: if someone
		// widens rule 2 to "tag:pacs:*", these assertions fail and the save
		// is rejected. That is deliberate.
		{
			"src": "rfinlay813@outlook.com",
			"proto": "tcp",
			"accept": ["tag:pacs:22", "tag:pacs:3389"],
			"deny": [
				"tag:pacs:445",  // SMB
				"tag:pacs:5985", // WinRM HTTP
				"tag:pacs:5986", // WinRM HTTPS
				"tag:pacs:139",  // NetBIOS
			],
		},

		// === A tagged RGF device (if one ever exists) reaches PACS on 22/3389
		//     and nothing else. =============================================
		{
			"src": "tag:rgf",
			"proto": "tcp",
			"accept": ["tag:pacs:22", "tag:pacs:3389"],
			"deny": ["tag:pacs:445"],
		},
	],

	// ------------------------------------------------------------------------
	// AFTER THE ENGAGEMENT ENDS
	//   1. Admin console > Machines > luis-pacs > ... > Remove.
	//   2. Admin console > Settings > Keys > revoke the tag:pacs auth key.
	//   3. Optionally strip tag:pacs from tagOwners and delete rules 2 and 3
	//      plus the tag:pacs tests, returning the policy to Rick-only.
	//   4. On Luis's box: `tailscale logout`, then uninstall Tailscale.
	// ------------------------------------------------------------------------
}
